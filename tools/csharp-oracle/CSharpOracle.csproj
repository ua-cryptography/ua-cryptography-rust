<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Produces reference fixtures for the Rust tests with the C# implementation and its test oracles (BouncyCastle,
    System.Security.Cryptography.Xml). The C# repository is expected next to this one; override with
    `dotnet run -p:CSharpRepo=/path/to/ua-cryptography-csharp`.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- The name the C# libraries grant InternalsVisibleTo, so the test support code compiles unchanged. -->
    <AssemblyName>UA.Cryptography.Tests</AssemblyName>
    <RootNamespace>CSharpOracle</RootNamespace>
    <NoWarn>$(NoWarn);CS1591;xUnit1013</NoWarn>
    <CSharpRepo Condition="'$(CSharpRepo)' == ''">$(MSBuildThisFileDirectory)../../../ua-cryptography-csharp</CSharpRepo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    <PackageReference Include="xunit" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="UA.Cryptography.Tests.Support" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(CSharpRepo)/tests/UA.Cryptography.Tests/Support/**/*.cs" Link="Support/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(CSharpRepo)/src/UA.Cryptography/UA.Cryptography.csproj" />
    <ProjectReference Include="$(CSharpRepo)/src/UA.Cryptography.Pki/UA.Cryptography.Pki.csproj" />
    <ProjectReference Include="$(CSharpRepo)/src/UA.Cryptography.Cli/UA.Cryptography.Cli.csproj" />
  </ItemGroup>

</Project>
