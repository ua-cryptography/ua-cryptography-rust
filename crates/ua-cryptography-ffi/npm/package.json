{
  "name": "ua-cryptography",
  "description": "Ukrainian cryptography in WebAssembly: DSTU 4145, DSTU 7564 (Kupyna), DSTU 7624 (Kalyna), GOST 28147-89, GOST 34.311-95, and CAdES, XAdES and ASiC signatures of the Ukrainian PKI",
  "keywords": [
    "dstu4145",
    "kupyna",
    "kalyna",
    "gost",
    "cades",
    "xades",
    "asic",
    "digital-signature",
    "ukraine",
    "wasm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ua-cryptography/ua-cryptography-rust.git",
    "directory": "crates/ua-cryptography-ffi"
  },
  "homepage": "https://github.com/ua-cryptography/ua-cryptography-rust",
  "bugs": "https://github.com/ua-cryptography/ua-cryptography-rust/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./ua_cryptography.d.ts",
      "node": "./node.js",
      "default": "./ua_cryptography.js"
    },
    "./ua_cryptography_bg.wasm": "./ua_cryptography_bg.wasm"
  },
  "main": "./node.js",
  "module": "./ua_cryptography.js",
  "types": "./ua_cryptography.d.ts",
  "files": [
    "ua_cryptography.js",
    "ua_cryptography.d.ts",
    "ua_cryptography_bg.wasm",
    "ua_cryptography_bg.wasm.d.ts",
    "node.js",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": [
    "./node.js"
  ],
  "engines": {
    "node": ">=20.19"
  }
}
